set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY adsp2100_conditional_trap_slice
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY ../../build/quartus_conditional_trap
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/core/adsp2100_condition_logic.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/core/adsp2100_conditional_trap_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/core/adsp2100_conditional_trap_slice.sv
set_global_assignment -name SDC_FILE conditional_trap_smoke.sdc
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"

