set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY adsp2100_instruction_cache
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY ../../build/quartus_instruction_cache
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/core/adsp2100_instruction_cache.sv
set_global_assignment -name SDC_FILE instruction_cache_smoke.sdc
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_instance_assignment -name VIRTUAL_PIN ON -to reset_i
set_instance_assignment -name VIRTUAL_PIN ON -to fill_i
set_instance_assignment -name VIRTUAL_PIN ON -to fill_address_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to fill_address_valid_i
set_instance_assignment -name VIRTUAL_PIN ON -to fill_instruction_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to fill_instruction_valid_i
set_instance_assignment -name VIRTUAL_PIN ON -to lookup_address_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to lookup_address_valid_i
set_instance_assignment -name VIRTUAL_PIN ON -to "*_o"
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
