set_instance_assignment -name VIRTUAL_PIN ON -to write_address_0_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to write_data_0_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to write_enable_1_i
set_instance_assignment -name VIRTUAL_PIN ON -to write_address_1_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to write_data_1_i[*]
