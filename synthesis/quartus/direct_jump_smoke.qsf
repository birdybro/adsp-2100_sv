set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY adsp2100_direct_jump_slice
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY ../../build/quartus_direct_jump
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/core/adsp2100_condition_logic.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/core/adsp2100_direct_jump_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/core/adsp2100_counter.sv
