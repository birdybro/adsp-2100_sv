set_instance_assignment -name VIRTUAL_PIN ON -to loop_overflow_o
set_instance_assignment -name VIRTUAL_PIN ON -to loop_depth_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to loop_push_accepted_o
set_instance_assignment -name VIRTUAL_PIN ON -to loop_overflow_event_o
set_instance_assignment -name VIRTUAL_PIN ON -to loop_empty_pop_o
set_instance_assignment -name VIRTUAL_PIN ON -to sstat_fragment_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to write_conflict_o

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
set_global_assignment -name SEED 2
