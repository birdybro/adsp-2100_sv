set_instance_assignment -name VIRTUAL_PIN ON -to pc_overflow_o
set_instance_assignment -name VIRTUAL_PIN ON -to pc_depth_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to pc_push_accepted_o
set_instance_assignment -name VIRTUAL_PIN ON -to pc_overflow_event_o
set_instance_assignment -name VIRTUAL_PIN ON -to pc_empty_pop_o
set_instance_assignment -name VIRTUAL_PIN ON -to count_push_i
set_instance_assignment -name VIRTUAL_PIN ON -to count_pop_i
set_instance_assignment -name VIRTUAL_PIN ON -to count_push_data_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to count_top_data_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to count_top_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to count_pop_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to count_empty_o
set_instance_assignment -name VIRTUAL_PIN ON -to count_overflow_o
set_instance_assignment -name VIRTUAL_PIN ON -to count_depth_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to count_push_accepted_o
set_instance_assignment -name VIRTUAL_PIN ON -to count_overflow_event_o
set_instance_assignment -name VIRTUAL_PIN ON -to count_empty_pop_o
set_instance_assignment -name VIRTUAL_PIN ON -to loop_push_i
set_instance_assignment -name VIRTUAL_PIN ON -to loop_pop_i
set_instance_assignment -name VIRTUAL_PIN ON -to loop_push_data_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to loop_top_data_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to loop_top_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to loop_pop_valid_o
