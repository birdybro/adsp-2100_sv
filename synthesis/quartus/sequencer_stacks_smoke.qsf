set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY adsp2100_sequencer_stacks
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY ../../build/quartus_sequencer_stacks
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/core/adsp2100_sequencer_stacks.sv
set_global_assignment -name SDC_FILE sequencer_stacks_smoke.sdc
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"

set_location_assignment PIN_V11 -to clk_i
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_i
set_instance_assignment -name VIRTUAL_PIN ON -to reset_i
set_instance_assignment -name VIRTUAL_PIN ON -to pc_push_i
set_instance_assignment -name VIRTUAL_PIN ON -to pc_pop_i
