set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY adsp2100_divide_sign_slice
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY ../../build/quartus_divide_sign
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/adsp2100_register_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/core/adsp2100_divide_sign_decode.sv
