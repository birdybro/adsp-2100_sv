set_instance_assignment -name VIRTUAL_PIN ON -to dreg_setup_data_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to af_setup_write_i
set_instance_assignment -name VIRTUAL_PIN ON -to af_setup_data_i[*]

