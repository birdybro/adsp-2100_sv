set_instance_assignment -name VIRTUAL_PIN ON -to mstat_write_data_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to imask_write_i
set_instance_assignment -name VIRTUAL_PIN ON -to imask_write_data_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to counter_load_i
set_instance_assignment -name VIRTUAL_PIN ON -to counter_load_data_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to pc_push_i
set_instance_assignment -name VIRTUAL_PIN ON -to pc_push_data_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to loop_push_i
set_instance_assignment -name VIRTUAL_PIN ON -to loop_push_data_i[*]

set_instance_assignment -name VIRTUAL_PIN ON -to boundary_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to invalid_opcode_o
