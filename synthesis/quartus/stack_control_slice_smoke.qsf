set_instance_assignment -name VIRTUAL_PIN ON -to counter_empty_manual_pop_o
set_instance_assignment -name VIRTUAL_PIN ON -to pc_top_data_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to count_top_data_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to loop_top_data_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to status_top_data_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to stack_top_valid_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to pc_depth_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to count_depth_o[*]
