set_instance_assignment -name VIRTUAL_PIN ON -to pc_pop_o
set_instance_assignment -name VIRTUAL_PIN ON -to has_effect_o
set_instance_assignment -name VIRTUAL_PIN ON -to astat_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to mstat_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to imask_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to alternate_bank_o
set_instance_assignment -name VIRTUAL_PIN ON -to bit_reverse_o
