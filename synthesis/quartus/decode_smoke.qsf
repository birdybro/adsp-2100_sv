set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY adsp2100_class_decode
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY ../../build/quartus_decode
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/adsp2100_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/adsp2100_decode_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/core/adsp2100_class_decode.sv
set_global_assignment -name SDC_FILE decode_smoke.sdc
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_instance_assignment -name VIRTUAL_PIN ON -to opcode_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to instruction_class_o[*]

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
