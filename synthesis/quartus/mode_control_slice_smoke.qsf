set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY adsp2100_mode_control_slice
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY ../../build/quartus_mode_control_slice
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/core/adsp2100_mode_control_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/core/adsp2100_status_registers.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/core/adsp2100_mode_control_slice.sv
set_global_assignment -name SDC_FILE mode_control_slice_smoke.sdc
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"

set_location_assignment PIN_V11 -to clk_i
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_i
set_instance_assignment -name VIRTUAL_PIN ON -to reset_i
set_instance_assignment -name VIRTUAL_PIN ON -to execute_i
set_instance_assignment -name VIRTUAL_PIN ON -to opcode_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to mstat_setup_write_i
set_instance_assignment -name VIRTUAL_PIN ON -to mstat_setup_write_data_i[*]

set_instance_assignment -name VIRTUAL_PIN ON -to boundary_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to invalid_opcode_o
set_instance_assignment -name VIRTUAL_PIN ON -to integration_conflict_o
set_instance_assignment -name VIRTUAL_PIN ON -to internal_conflict_o
set_instance_assignment -name VIRTUAL_PIN ON -to decoded_mode_sr_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to decoded_mode_br_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to decoded_mode_ol_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to decoded_mode_as_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to decoded_has_effect_o
set_instance_assignment -name VIRTUAL_PIN ON -to decoded_has_alias_o
set_instance_assignment -name VIRTUAL_PIN ON -to mstat_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to alternate_bank_o
set_instance_assignment -name VIRTUAL_PIN ON -to bit_reverse_o
set_instance_assignment -name VIRTUAL_PIN ON -to overflow_latch_o
set_instance_assignment -name VIRTUAL_PIN ON -to saturate_ar_o

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
set_global_assignment -name SEED 2
