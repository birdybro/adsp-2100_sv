set_instance_assignment -name VIRTUAL_PIN ON -to setup_kind_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to setup_address_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to setup_data_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to probe_address_i[*]

set_instance_assignment -name VIRTUAL_PIN ON -to probe_i_data_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to probe_i_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to probe_m_data_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to probe_m_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to probe_l_data_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to probe_l_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to boundary_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to invalid_opcode_o
set_instance_assignment -name VIRTUAL_PIN ON -to integration_conflict_o
set_instance_assignment -name VIRTUAL_PIN ON -to invalid_setup_kind_o
set_instance_assignment -name VIRTUAL_PIN ON -to internal_conflict_o
set_instance_assignment -name VIRTUAL_PIN ON -to operands_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to configuration_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to writeback_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to selected_dag2_o
set_instance_assignment -name VIRTUAL_PIN ON -to selected_i_local_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to selected_m_local_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to selected_i_address_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to selected_m_address_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to selected_old_i_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to selected_m_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to selected_l_o[*]
