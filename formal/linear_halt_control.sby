read -formal -sv rtl/core/adsp2100_conditional_shift_decode.sv
read -formal -sv rtl/core/adsp2100_shifter.sv
read -formal -sv rtl/core/adsp2100_immediate_shift_action.sv
read -formal -sv rtl/core/adsp2100_conditional_shift_action.sv
read -formal -sv rtl/core/adsp2100_program_bus.sv
read -formal -sv rtl/core/adsp2100_linear_fetch_client.sv
read -formal -sv rtl/core/adsp2100_linear_core_slice.sv
read -formal -sv rtl/core/adsp2100_halt_control.sv
read -formal -sv rtl/core/adsp2100_linear_halt_control_slice.sv
read -formal -sv formal/harnesses/adsp2100_linear_halt_control_formal.sv
prep -top adsp2100_linear_halt_control_formal

