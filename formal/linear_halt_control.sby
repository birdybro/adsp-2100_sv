[options]
mode prove
depth 32

[engines]
smtbmc boolector

[script]
read -formal -sv rtl/packages/adsp2100_pkg.sv
read -formal -sv rtl/packages/adsp2100_register_pkg.sv
read -formal -sv rtl/core/adsp2100_load_dreg_immediate_decode.sv
read -formal -sv rtl/core/adsp2100_load_non_dreg_immediate_decode.sv
