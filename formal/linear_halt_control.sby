read -formal -sv rtl/core/adsp2100_counter.sv
read -formal -sv rtl/core/adsp2100_sequencer_stacks.sv
read -formal -sv rtl/core/adsp2100_status_stack.sv
read -formal -sv rtl/core/adsp2100_architectural_state.sv
read -formal -sv rtl/core/adsp2100_internal_move_slice.sv
read -formal -sv rtl/core/adsp2100_condition_logic.sv
read -formal -sv rtl/core/adsp2100_conditional_compute_decode.sv
read -formal -sv rtl/core/adsp2100_alu.sv
